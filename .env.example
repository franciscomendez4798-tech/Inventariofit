# ══════════════════════════════════════════════════════════════════════════════
# .env.example — Plantilla de variables de entorno
# ══════════════════════════════════════════════════════════════════════════════
# INSTRUCCIONES:
#   1. Copia este archivo:   cp .env.example .env
#   2. Rellena los valores   (nunca subas .env al repositorio)
#   3. En hosting remoto:    configura estas mismas variables en el panel web

# ── Flask ─────────────────────────────────────────────────────────────────────
# Genera una clave segura con:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CAMBIA-ESTO-POR-UNA-CLAVE-ALEATORIA-DE-64-CHARS

# 'development' | 'production' | 'testing'
FLASK_ENV=production

# ── Claves de seguridad adicionales ───────────────────────────────────────────
# Clave independiente para firmas HMAC de Órdenes de Servicio.
# Genera con:  python3 -c "import secrets; print(secrets.token_hex(32))"
FIRMA_SECRET_KEY=OTRA-CLAVE-ALEATORIA-DIFERENTE-A-SECRET_KEY

# ── Base de datos ─────────────────────────────────────────────────────────────
# Opción A — PostgreSQL (Render / Supabase / AWS RDS):
# DATABASE_URL=postgresql://USUARIO:PASSWORD@HOST:5432/NOMBRE_DB

# Opción B — SQLite (solo para pruebas, datos no persisten en Render Free):
# Si DATABASE_URL no está definida, el sistema usa SQLite automáticamente.

# ── Render — Disk persistente (opcional, plan gratuito no lo incluye) ─────────
# Si tienes un Disk en Render montado en /data, SQLite sí persistirá.
# No necesitas definir ninguna variable extra, el sistema detecta /data solo.

# ── PythonAnywhere ────────────────────────────────────────────────────────────
# Con PythonAnywhere Free, SQLite persiste en el sistema de archivos.
# Solo necesitas SECRET_KEY y FLASK_ENV=production.

# ── AWS RDS (Free Tier 12 meses) ─────────────────────────────────────────────
# DATABASE_URL=postgresql://admin:PASSWORD@tu-instancia.us-east-1.rds.amazonaws.com:5432/inventario

# ── Sesión ───────────────────────────────────────────────────────────────────
# Tiempo de inactividad antes de cerrar sesión (en segundos). Default: 3 horas
SESSION_INACTIVITY_TIMEOUT=10800

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Dejar en blanco para usar memoria (suficiente para 1 instancia).
# Con Redis (mejor para múltiples workers):
# REDIS_URL=redis://HOST:6379/0

# ── Puerto (solo AWS EC2 / VPS directo) ───────────────────────────────────────
# En Render/Railway el puerto lo asigna la plataforma via $PORT automáticamente.
# PORT=8000
